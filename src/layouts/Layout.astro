---
import { createHash } from "node:crypto";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BootIntro from "../components/BootIntro.astro";
import Circuit from "../components/Circuit.astro";
import { profile, seo } from "../data/site";

// CSP Level 3 supports style-src-attr, but Astro's directive union does not yet include it.
// @ts-expect-error -- required for authored CSS custom properties in style attributes.
Astro.csp?.insertDirective("style-src-attr 'unsafe-inline'");

// Astro hashes processed scripts but NOT is:inline ones (audit B14), so inline
// scripts are authored as strings in src/data/inline-scripts.ts, emitted with
// set:html, and allowlisted here. Registration must happen at the layout level:
// component-level insertScriptHash calls never reach the emitted CSP meta.
// scripts/check-build.mjs re-hashes every inline script in dist and fails the
// build if any is missing from the CSP meta — drift cannot ship silently.
import { bootScript, jsFlagScript } from "../data/inline-scripts";
const cspHash = (code: string): `sha256-${string}` => `sha256-${createHash("sha256").update(code).digest("base64")}`;
Astro.csp?.insertScriptHash(cspHash(jsFlagScript));
Astro.csp?.insertScriptHash(cspHash(bootScript));

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description: profile.tagline,
  url: canonical,
  image: new URL("/og.png", canonical).href,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  address: { "@type": "PostalAddress", addressLocality: "Hyderabad", addressRegion: "Telangana", addressCountry: "IN" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "RGUKT Srikakulam" },
  knowsAbout: ["Embedded Linux", "Yocto Project", "Firmware", "ESP-IDF", "STM32", "Rust", "On-device ML"],
  sameAs: [profile.github, profile.linkedin],
};
const personLdJson = JSON.stringify(personLd).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="keywords" content={seo.keywords.join(", ")} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#0A0E14" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${profile.name} — Portfolio`} />
    <meta property="og:image" content={`${canonical}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.ogDescription} />
    <meta name="twitter:image" content={`${canonical}og.png`} />

    <script is:inline type="application/ld+json" set:html={personLdJson} />
    <!-- Enable JS-gated styles before paint (avoids reveal flash) -->
    <script is:inline set:html={jsFlagScript} />
  </head>
  <body>
    <BootIntro />
    <a class="skip-link" href="#main">Skip to content</a>
    <Circuit />
    <div class="cursor-glow" aria-hidden="true"></div>
    <div class="signal-rail" aria-hidden="true">
      <div class="signal-rail__line"></div>
      <div class="signal-rail__fill"></div>
      <div class="signal-rail__node"></div>
    </div>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ---- Scroll reveal ----
      const revealEls = document.querySelectorAll(
        ".reveal, .fade, .section-head, .trace-div, .cert"
      );
      if (reduceMotion || !("IntersectionObserver" in window)) {
        revealEls.forEach((el) => el.classList.add("in-view"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -10% 0px" }
        );
        revealEls.forEach((el) => io.observe(el));
        document.documentElement.classList.add("reveal-ready");
      }

      // ---- Hero underline draw on load ----
      const hero = document.querySelector(".hero");
      if (hero) {
        const ems = hero.querySelectorAll(".hero__lead em");
        ems.forEach((em, i) => (em as HTMLElement).style.setProperty("--d", `${600 + i * 160}ms`));
        window.requestAnimationFrame(() => hero.classList.add("lead-drawn"));
      }

      // ---- Nav scroll-spy ----
      const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav__link"));
      const sectionToLink = new Map<Element, HTMLAnchorElement>();
      navLinks.forEach((l) => {
        const id = l.getAttribute("href")?.slice(1);
        if (id) {
          const sec = document.getElementById(id);
          if (sec) sectionToLink.set(sec, l);
        }
      });
      if ("IntersectionObserver" in window) {
        const spy = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              const link = sectionToLink.get(e.target);
              if (link && e.isIntersecting) {
                navLinks.forEach((x) => x.removeAttribute("aria-current"));
                link.setAttribute("aria-current", "location");
              }
            });
          },
          { rootMargin: "-45% 0px -50% 0px", threshold: 0 }
        );
        sectionToLink.forEach((_l, sec) => spy.observe(sec));
      }

      // ---- Signal-rail scroll progress ----
      let scrollRaf = 0;
      const updateScrollProgress = () => {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const p = max > 0 ? window.scrollY / max : 0;
        document.documentElement.style.setProperty("--scrollp", String(p));
        // At the very bottom, force the last section active (the spy band can
        // sit above a short final section + footer).
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
          const last = document.querySelector<HTMLAnchorElement>('.nav__link[href="#contact"]');
          if (last) {
            navLinks.forEach((x) => x.removeAttribute("aria-current"));
            last.setAttribute("aria-current", "location");
          }
        }
      };
      const onScroll = () => {
        if (scrollRaf) return;
        scrollRaf = window.requestAnimationFrame(() => {
          updateScrollProgress();
          scrollRaf = 0;
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      updateScrollProgress();

      // ---- Copy to clipboard (with legacy fallback) ----
      const copyText = async (text: string): Promise<boolean> => {
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            return true;
          }
        } catch {
          /* fall through to legacy path */
        }
        try {
          const ta = document.createElement("textarea");
          ta.dataset.copyFallback = "";
          ta.value = text;
          ta.setAttribute("readonly", "");
          ta.style.position = "absolute";
          ta.style.left = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const legacyCopy = Reflect.get(document, "execCommand");
          return typeof legacyCopy === "function" && legacyCopy.call(document, "copy");
        } catch {
          return false;
        } finally {
          document.querySelector("textarea[data-copy-fallback]")?.remove();
        }
      };
      const copyStatus = document.getElementById("copy-status");
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const ok = await copyText(btn.getAttribute("data-copy") || "");
          if (!ok) {
            if (copyStatus) copyStatus.textContent = "Copy failed. Please select and copy the value manually.";
            return;
          }
          const prev = btn.textContent;
          const prevLabel = btn.getAttribute("aria-label");
          btn.textContent = "copied ✓";
          btn.setAttribute("aria-label", "Copied");
          btn.classList.add("copied");
          if (copyStatus) copyStatus.textContent = `${prevLabel || "Value"} copied to clipboard.`;
          window.setTimeout(() => {
            btn.textContent = prev;
            if (prevLabel) btn.setAttribute("aria-label", prevLabel);
            btn.classList.remove("copied");
          }, 1400);
        });
      });

      // ---- Mobile menu ----
      const menuBtn = document.querySelector<HTMLButtonElement>(".nav__menu-btn");
      const navList = document.getElementById("nav-links");
      const closeMenu = () => {
        navList?.removeAttribute("data-open");
        menuBtn?.setAttribute("aria-expanded", "false");
      };
      menuBtn?.addEventListener("click", () => {
        const open = navList?.toggleAttribute("data-open");
        menuBtn.setAttribute("aria-expanded", String(!!open));
      });
      document.querySelectorAll(".nav__link").forEach((l) =>
        l.addEventListener("click", closeMenu)
      );
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && navList?.hasAttribute("data-open")) {
          closeMenu();
          menuBtn?.focus();
        }
      });
      document.addEventListener("pointerdown", (e) => {
        const target = e.target as Node;
        if (
          navList?.hasAttribute("data-open") &&
          !navList.contains(target) &&
          !menuBtn?.contains(target)
        ) {
          closeMenu();
        }
      });
      // Same query as the CSS mobile block — inverse queries left a fractional
      // width where neither matched.
      window.matchMedia("(max-width: 860px)").addEventListener("change", (e) => {
        if (!e.matches) closeMenu();
      });

      // ---- Cursor glow over the grid + per-card spotlight ----
      const finePointer = window.matchMedia("(pointer: fine)").matches;
      if (finePointer && !reduceMotion) {
        let mx = 0, my = 0, raf = 0;
        window.addEventListener(
          "pointermove",
          (e) => {
            mx = e.clientX;
            my = e.clientY;
            document.body.classList.add("cursor-on");
            if (!raf)
              raf = window.requestAnimationFrame(() => {
                document.documentElement.style.setProperty("--mx", mx + "px");
                document.documentElement.style.setProperty("--my", my + "px");
                raf = 0;
              });
          },
          { passive: true }
        );
        document.addEventListener("pointerleave", () => document.body.classList.remove("cursor-on"));
        // Flagship cards: cursor spotlight glow
        document.querySelectorAll<HTMLElement>(".pcard").forEach((card) => {
          card.addEventListener(
            "pointermove",
            (e) => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty("--cx", e.clientX - rect.left + "px");
              card.style.setProperty("--cy", e.clientY - rect.top + "px");
            },
            { passive: true }
          );
        });
        // Magnetic buttons
        document.querySelectorAll<HTMLElement>(".btn").forEach((btn) => {
          btn.addEventListener(
            "pointermove",
            (e) => {
              const r = btn.getBoundingClientRect();
              btn.style.setProperty("--tx", ((e.clientX - r.left - r.width / 2) * 0.28).toFixed(1) + "px");
              btn.style.setProperty("--ty", ((e.clientY - r.top - r.height / 2) * 0.4).toFixed(1) + "px");
            },
            { passive: true }
          );
          btn.addEventListener("pointerleave", () => {
            btn.style.setProperty("--tx", "0px");
            btn.style.setProperty("--ty", "0px");
          });
        });
      }

      // ---- Print: closed disclosures must not hide content on paper ----
      window.addEventListener("beforeprint", () => {
        document.querySelectorAll<HTMLDetailsElement>("details:not([open])").forEach((d) => {
          d.dataset.printOpened = "";
          d.open = true;
        });
      });
      window.addEventListener("afterprint", () => {
        document.querySelectorAll<HTMLDetailsElement>("details[data-print-opened]").forEach((d) => {
          delete d.dataset.printOpened;
          d.open = false;
        });
      });

      // ---- Count-up numbers ----
      const counters = document.querySelectorAll<HTMLElement>("[data-count]");
      if (counters.length) {
        const runCount = (el: HTMLElement) => {
          const target = parseFloat(el.dataset.count || "0");
          const dec = parseInt(el.dataset.dec || "0", 10);
          if (reduceMotion) {
            el.textContent = target.toFixed(dec);
            return;
          }
          const dur = 1000;
          let startT = 0;
          const tick = (t: number) => {
            if (!startT) startT = t;
            const p = Math.min(1, (t - startT) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = (target * eased).toFixed(dec);
            if (p < 1) window.requestAnimationFrame(tick);
            else el.textContent = target.toFixed(dec);
          };
          window.requestAnimationFrame(tick);
        };
        if (reduceMotion || !("IntersectionObserver" in window)) {
          counters.forEach(runCount);
        } else {
          // Markup ships real values for no-JS and failure-safe rendering.
          counters.forEach((el) => {
            el.textContent = (0).toFixed(parseInt(el.dataset.dec || "0", 10));
          });
          const countIO = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  runCount(e.target as HTMLElement);
                  countIO.unobserve(e.target);
                }
              });
            },
            { threshold: 0.6 }
          );
          counters.forEach((el) => countIO.observe(el));
        }
      }
    </script>
  </body>
</html>
