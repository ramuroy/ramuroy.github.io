---
// GitHub Pages serves dist/404.html for unknown URLs; without it visitors get
// the unbranded GitHub default (audit seo-meta). Standalone page: the one-page
// Layout's fragment navigation would be meaningless here.
import "../styles/global.css";
import { profile } from "../data/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — page not found · {profile.name}</title>
    <meta name="description" content="This page does not exist. Return to Ramu Roy's portfolio." />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0A0E14" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  </head>
  <body>
    <main class="nf">
      <div class="nf__panel ticked">
        <p class="nf__prompt">rr@embedded:~$ <span class="nf__cmd">cat {"<requested page>"}</span></p>
        <p class="nf__err">cat: no such file or directory <span class="nf__code">[ err 404 ]</span></p>
        <h1 class="nf__title">Signal lost.</h1>
        <p class="nf__desc">The page you probed doesn't exist — it may have been moved, renamed, or never routed.</p>
        <a class="btn btn-primary" href="/">RETURN TO PORTFOLIO <span aria-hidden="true">▸</span></a>
      </div>
    </main>
  </body>
</html>

<style>
  .nf { min-height: 100svh; display: grid; place-items: center; padding: var(--gutter); }
  .nf__panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.5rem, 5vw, 3rem); max-width: 560px; width: 100%; display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
  .nf__prompt { font-family: var(--font-mono); font-size: var(--fs-small); color: var(--text-secondary); }
  .nf__cmd { color: var(--text); }
  .nf__err { font-family: var(--font-mono); font-size: var(--fs-small); color: var(--muted); }
  .nf__code { color: var(--warn); }
  .nf__title { font-size: var(--fs-h2); color: var(--text); margin-top: var(--space-2); }
  .nf__desc { color: var(--text-secondary); margin-bottom: var(--space-4); }
</style>
