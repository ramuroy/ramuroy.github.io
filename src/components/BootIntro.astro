---
import { bootLines } from "../data/site";
import { bootScript } from "../data/inline-scripts";

// The boot script lives in src/data/inline-scripts.ts; its CSP hash is
// registered by Layout.astro (component-level insertScriptHash calls do not
// reach the emitted CSP meta). Behavior notes live with the script string.
---
<div id="boot-intro" class="boot" role="dialog" aria-modal="true" aria-label="Portfolio loading introduction">
  <button class="boot__skip" type="button">skip intro ▸</button>
  <div class="boot__panel" aria-hidden="true">
    {bootLines.map((line, i) => {
      const [before, after] = line.split("[ ok ]");
      const hasStatus = after !== undefined;
      const isLast = i === bootLines.length - 1;
      return (
        <p class="boot__line" style={`--i:${i}`}>{hasStatus ? <Fragment>{before}[ <span class="ok">ok</span> ]{after}</Fragment> : line}{isLast && <span class="caret" aria-hidden="true"></span>}</p>
      );
    })}
  </div>
</div>

<script is:inline set:html={bootScript} />
