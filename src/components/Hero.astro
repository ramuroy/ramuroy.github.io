---
import { hero } from "../data/site";
---
<section class="hero" aria-label="Introduction">
  <canvas class="hero__canvas" aria-hidden="true"></canvas>
  <div class="container hero__grid">
    <div class="hero__main">
      <p class="hero__eyebrow">
        <span class="led" aria-hidden="true"><span class="led__dot"></span></span>
        <span class="eyebrow">// {hero.eyebrow}</span>
      </p>

      {/* The scramble effect rewrites only the aria-hidden visual span; the
          accessible name of the page's h1 stays stable (audit B10). */}
      <h1><span class="hero__name"><span class="sr-only">{hero.name}</span><span class="hero__name-visual" aria-hidden="true" data-text={hero.name}>{hero.name}</span></span><span class="end" aria-hidden="true">.</span></h1>

      {/* IC topmark: the name presented as a chip marking, pin-1 dot included */}
      <div class="hero__topmark" aria-hidden="true">
        {hero.topmark.map((line, i) => (
          <span class="hero__topmark-line">{i === 0 && <span class="pin1"></span>}{line}</span>
        ))}
      </div>

      <p class="hero__lead">
        {hero.lead.map((seg) =>
          seg.arrow ? (
            <Fragment>{" "}<span class="arrow" aria-hidden="true">{seg.label}</span>{" "}</Fragment>
          ) : seg.em ? (
            <em>{seg.t}</em>
          ) : (
            <Fragment>{seg.t}</Fragment>
          )
        )}
      </p>

      <div class="hero__ctas">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>
          {hero.ctaPrimary.label} <span aria-hidden="true">{hero.ctaPrimary.glyph}</span>
        </a>
        <a class="btn btn-ghost" href={hero.ctaGhost.href} download>
          {hero.ctaGhost.label} <span aria-hidden="true">{hero.ctaGhost.glyph}</span>
        </a>
      </div>

    </div>

    <aside class="hero__spec" aria-label="Key specifications">
      <div class="spec-card ticked">
        <p class="spec-card__label"><span aria-hidden="true">▣</span> key specifications</p>
        <dl class="spec">
          {hero.keySpecs.map((s) => (
            <div class="spec__row hoverable">
              <dt>{s.k}</dt>
              <dd class={s.active ? "is-active" : ""}>
                {s.status ? (
                  <span class:list={["pill", s.available ? "pill--production" : "pill--wip"]}>
                    {s.available && <span class="pill__dot"></span>}{s.v}
                  </span>
                ) : (
                  s.v
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to content">scroll</a>
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // ---- Interactive constellation / circuit canvas ----
  const canvas = document.querySelector<HTMLCanvasElement>(".hero__canvas");
  const section = canvas?.closest(".hero") as HTMLElement | null;
  if (canvas && section && !reduce) {
    const ctx = canvas.getContext("2d")!;
    let DPR = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0, raf = 0, lastT = 0;
    let running = false, started = false, onScreen = true;
    const mouse = { x: -9999, y: -9999 };
    type Node = { x: number; y: number; vx: number; vy: number };
    let nodes: Node[] = [];

    const targetCount = () => Math.min(76, Math.max(28, Math.floor((w * h) / 13000)));
    const spawn = (): Node => ({
      x: Math.random() * w,
      y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.28,
      vy: (Math.random() - 0.5) * 0.28,
    });
    const resize = () => {
      const r = section.getBoundingClientRect();
      const ow = w, oh = h;
      w = r.width; h = r.height;
      DPR = Math.min(window.devicePixelRatio || 1, 2); // re-read: window may move across monitors
      canvas.width = w * DPR; canvas.height = h * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      if (!nodes.length || !ow || !oh) {
        nodes = Array.from({ length: targetCount() }, spawn);
        return;
      }
      // Rescale existing nodes and top up / trim to the new density — mobile
      // URL-bar resizes must not teleport the whole constellation (audit B8).
      for (const n of nodes) { n.x *= w / ow; n.y *= h / oh; }
      const want = targetCount();
      while (nodes.length < want) nodes.push(spawn());
      nodes.length = Math.min(nodes.length, want);
    };
    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });

    const LINK = 124, NEAR = 150;
    const step = (t: number) => {
      // Physics scale with elapsed time so speed is identical on 60 and 144 Hz
      // displays (audit B8); dt is capped so background tabs don't jump.
      const dt = lastT ? Math.min(3, (t - lastT) / 16.667) : 1;
      lastT = t;
      ctx.clearRect(0, 0, w, h);
      for (const n of nodes) {
        n.x += n.vx * dt; n.y += n.vy * dt;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
        const dx = mouse.x - n.x, dy = mouse.y - n.y, d = Math.hypot(dx, dy);
        if (d < NEAR && d > 0.01) { n.x += (dx / d) * 0.5 * dt; n.y += (dy / d) * 0.5 * dt; }
      }
      // links
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i], b = nodes[j];
          const dx = a.x - b.x, dy = a.y - b.y, d = Math.hypot(dx, dy);
          if (d < LINK) {
            ctx.strokeStyle = `rgba(0,229,255,${(1 - d / LINK) * 0.28})`;
            ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
      }
      // nodes
      for (const n of nodes) {
        const near = Math.hypot(mouse.x - n.x, mouse.y - n.y) < NEAR;
        if (near) {
          ctx.fillStyle = "rgba(0,229,255,0.14)";
          ctx.beginPath(); ctx.arc(n.x, n.y, 6, 0, 7); ctx.fill();
        }
        ctx.fillStyle = near ? "rgba(0,229,255,0.95)" : "rgba(0,229,255,0.4)";
        ctx.beginPath(); ctx.arc(n.x, n.y, near ? 2.4 : 1.5, 0, 7); ctx.fill();
      }
      if (running) raf = requestAnimationFrame(step);
    };

    const pause = () => { running = false; cancelAnimationFrame(raf); };
    const maybePlay = () => {
      if (started && onScreen && !document.hidden && !running) {
        running = true;
        lastT = 0;
        raf = requestAnimationFrame(step);
      }
    };

    section.addEventListener("pointermove", (e) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top;
    }, { passive: true });
    section.addEventListener("pointerleave", () => { mouse.x = -9999; mouse.y = -9999; });

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        onScreen = entries[0].isIntersecting;
        onScreen ? maybePlay() : pause();
      });
      io.observe(section);
    }
    document.addEventListener("visibilitychange", () => {
      document.hidden ? pause() : maybePlay();
    });

    // Don't burn O(n²) frames behind the opaque boot overlay (audit B8):
    // start after rr:boot-done on first visits, immediately otherwise.
    const begin = () => {
      if (started) return;
      started = true;
      resize();
      maybePlay();
    };
    if (document.querySelector(".boot.is-active")) {
      window.addEventListener("rr:boot-done", begin, { once: true });
      window.setTimeout(begin, 3000); // safety net if the event is missed
    } else {
      begin();
    }
  }

  // ---- Glitch / scramble reveal on the name (on load + on hover) ----
  const nameEl = document.querySelector<HTMLElement>(".hero__name-visual");
  if (nameEl && !reduce) {
    const finalText = nameEl.dataset.text || nameEl.textContent || "";
    const glyphs = "!<>-_\\/[]{}=+*^?#________01";
    let active = false;
    const scramble = () => {
      if (active) return;
      active = true;
      // Lock the rendered width so proportional scramble glyphs don't make
      // the heading jitter horizontally (audit B10).
      nameEl.style.minWidth = `${nameEl.offsetWidth}px`;
      nameEl.style.display = "inline-block";
      const steps = 34;
      let frame = 0;
      const tick = () => {
        const revealed = (frame / steps) * finalText.length;
        let out = "";
        for (let i = 0; i < finalText.length; i++) {
          if (finalText[i] === " ") { out += " "; continue; }
          out += i < revealed ? finalText[i] : glyphs[Math.floor(Math.random() * glyphs.length)];
        }
        nameEl.textContent = out;
        frame++;
        if (frame <= steps) window.setTimeout(tick, 42);
        else { nameEl.textContent = finalText; active = false; }
      };
      tick();
    };
    // Run after the first-visit intro, or shortly after load for returning users.
    if (document.querySelector(".boot.is-active")) {
      window.addEventListener("rr:boot-done", () => window.setTimeout(scramble, 120), { once: true });
    } else {
      window.setTimeout(scramble, 250);
    }
    nameEl.addEventListener("pointerenter", scramble);
  }
</script>
