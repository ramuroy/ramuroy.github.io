---
import { flagship, gridProjects, profile, protocols, skillGroups } from "../data/site";
const projectCount = flagship.length + gridProjects.length;
const languageCount = skillGroups.find((group) => group.name === "Languages")?.items.length ?? 0;
const stats = [
  { value: profile.githubRepoCount, dec: 0, label: "GitHub repos" },
  { value: projectCount, dec: 0, label: "Projects" },
  { value: protocols.length, dec: 0, label: "Protocols" },
  { value: languageCount, dec: 0, label: "Programming languages" },
];
---
<section class="stats" aria-label="By the numbers">
  <div class="container stats__grid">
    {stats.map((s, i) => (
      <div class="stat reveal" style={`--i:${i}`}>
        <div class="stat__value"><span data-count={s.value} data-dec={s.dec}>{s.value}</span></div>
        <div class="stat__label">{s.label}</div>
      </div>
    ))}
  </div>
</section>
