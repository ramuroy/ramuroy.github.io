---
import PartitionMap from "./PartitionMap.astro";
import SectionHeader from "./SectionHeader.astro";
import TraceDivider from "./TraceDivider.astro";
import { flagship, gridProjects, sections } from "../data/site";

const slug = (url?: string) => (url ? url.replace("https://github.com/", "github.com/") : "");
// All projects render, in the data file's order (strongest first) — no
// star-sorting: a starred hobby board must not outrank stronger firmware work.
const grid = gridProjects;
const showDot = (v: string) => v === "deployed" || v === "production";
---
<section id="projects" class="section">
  <div class="container">
    <SectionHeader num={sections.projects.num} eyebrow={sections.projects.eyebrow} title={sections.projects.title} />

    <div class="projects__flagship">
      {flagship.map((p, i) => (
        <article class:list={["pcard", "ticked", "fade", { "card-full": p.full }]} style={`--i:${i}`}>
          <span class="card-glow" aria-hidden="true"></span>
          <div class="pcard__head">
            <span class="pcard__fig">{p.fig}</span>
            <div class="pcard__pills">
              {p.pills.map((pill) => (
                <span class:list={["pill", `pill--${pill.variant}`]}>
                  {showDot(pill.variant) && <span class="pill__dot"></span>}{pill.label}
                </span>
              ))}
            </div>
          </div>

          <div>
            <h3 class="pcard__title">{p.title}</h3>
            <p class="pcard__tagline">{p.tagline}</p>
          </div>

          <p class="pcard__desc">{p.description}</p>

          {p.images && (
            <div class="boards-wrap">
            <div class:list={["boards", { "boards--pair": p.images.length > 1 }]}>
              {p.images.map((img) => (
                <figure class="board">
                  {/* A real link: without JS this opens the full-size asset.
                      The script upgrades it to a dialog (spec H2, D-006). */}
                  <a
                    class="board__zoom"
                    href={img.src}
                    data-zoom
                    data-caption={img.caption}
                    aria-label={`View full size: ${img.caption}`}
                  >
                    <img
                      class="board__img"
                      src={img.src}
                      alt={img.alt}
                      width={img.w}
                      height={img.h}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <figcaption class="board__caption">{img.caption}</figcaption>
                </figure>
              ))}
            </div>
            </div>
          )}

          <div class="badges">
            {p.tech.map((t) => <span class="badge">{t}</span>)}
          </div>

          <div class="pcard__params cols">
            <dl class="spec">
              {p.params.map((row) => (
                <div class="spec__row hoverable">
                  <dt>{row.k}</dt>
                  <dd class={row.active ? "is-active" : ""}>{row.v}</dd>
                </div>
              ))}
            </dl>
          </div>

          {p.metrics && (
            <div class="metrics">
              <div class="metrics__label">Key figures</div>
              <dl class="metrics__list">
                {p.metrics.map((m) => (
                  <div class="metrics__row">
                    <dt>{m.k}</dt>
                    <dd>
                      <span class="metrics__v">{m.v}</span>
                      {m.note && <span class="metrics__note">{m.note}</span>}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {p.partitions && <PartitionMap {...p.partitions} />}

          <details class="pcard__details">
            <summary>Engineering detail</summary>
            <ul>
              {p.highlights.map((h, j) => <li style={`--i:${j}`}>{h}</li>)}
            </ul>
          </details>

          <div class="pcard__foot">
            {p.repo ? (
              <a class="pcard__ref" href={p.repo} target="_blank" rel="noopener noreferrer">
                REF → {slug(p.repo)} <span class="arrow" aria-hidden="true">→</span><span class="sr-only">(opens in new tab)</span>
              </a>
            ) : (
              <span class="pcard__norepo">{p.noRepoNote}</span>
            )}
            {p.stars ? <span class="star"><span aria-hidden="true">★ {p.stars}</span><span class="sr-only">{`${p.stars} GitHub ${p.stars === 1 ? "star" : "stars"}`}</span></span> : null}
          </div>
        </article>
      ))}
    </div>

    {/* One lightbox for the page. Empty and inert until a zoom link is used. */}
    <dialog class="lightbox" id="board-lightbox" aria-label="Board image, full size">
      <button class="lightbox__close" type="button" data-lightbox-close>
        Close <span aria-hidden="true">✕</span>
      </button>
      <img class="lightbox__img" alt="" />
      <p class="lightbox__caption" data-lightbox-caption></p>
    </dialog>

    <TraceDivider protocol="i2c" />

    <div class="projects__more">
      <div class="projects__more-head">
        <h3>// selected on github</h3>
        <a class="btn btn-ghost" href="https://github.com/ramuroy?tab=repositories" target="_blank" rel="noopener noreferrer">
          VIEW ALL ON GITHUB <span aria-hidden="true">↗</span><span class="sr-only">(opens in new tab)</span>
        </a>
      </div>
      <div class="pgrid">
        {grid.map((g, i) => (
          <div class="gcard fade" style={`--i:${i % 4}`}>
            <div class="gcard__top">
              {/* Stretched link: whole card stays clickable, but the accessible
                  link name is just the title, not a 25-word card dump (B28). */}
              {g.repo ? (
                <a class="gcard__title gcard__link" href={g.repo} target="_blank" rel="noopener noreferrer">{g.title}<span class="sr-only"> (opens in new tab)</span></a>
              ) : (
                <span class="gcard__title">{g.title}</span>
              )}
              {g.date && <span class="gcard__date">{g.date}</span>}
            </div>
            <p class="gcard__desc">{g.description}</p>
            <div class="badges">
              {g.tech.map((t) => <span class="badge">{t}</span>)}
            </div>
            <div class="gcard__foot">
              <span class="gcard__cat">{g.category}</span>
              {g.stars ? (
                <span class="star"><span aria-hidden="true">★ {g.stars}</span><span class="sr-only">{`${g.stars} GitHub ${g.stars === 1 ? "star" : "stars"}`}</span></span>
              ) : g.repo ? (
                <span class="gcard__cat"><span aria-hidden="true">↗</span> repo</span>
              ) : (
                <span class="gcard__cat">local</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Board images open full size. The markup is a working <a href> first, so
  // this only ever upgrades behaviour that already exists (spec H2, D-006).
  const dialog = document.getElementById("board-lightbox") as HTMLDialogElement | null;
  if (dialog && typeof dialog.showModal === "function") {
    const img = dialog.querySelector(".lightbox__img") as HTMLImageElement;
    const cap = dialog.querySelector("[data-lightbox-caption]") as HTMLElement;
    let opener: HTMLElement | null = null;

    for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-zoom]")) {
      link.addEventListener("click", (event) => {
        // Let modified clicks through — open in a new tab is a legitimate choice.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        const source = link.querySelector("img");
        opener = link;
        img.src = link.href;
        img.alt = source?.alt ?? "";
        cap.textContent = link.dataset.caption ?? "";
        dialog.showModal();
      });
    }

    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());

    // A click on the backdrop lands on the dialog itself, never on its children.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });

    // showModal traps focus but does not restore it; do that ourselves. The
    // image is left loaded on purpose — reopening is then instant, and an <img>
    // stripped of its src flashes its alt text on the way out.
    dialog.addEventListener("close", () => {
      opener?.focus();
      opener = null;
    });
  }
</script>
